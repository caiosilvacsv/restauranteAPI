# ==============================================================================
# Configurações de Exemplo de Ambiente - Restaurante API (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# Exemplo: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações do Container PostgreSQL (Docker Compose)
# ------------------------------------------------------------------------------
POSTGRES_DB=restaurante_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 2. Conexão do Spring Boot com o PostgreSQL (Datasource)
# NOTA DOCKER: Dentro do Docker Compose, o host do banco é 'postgres':
#   jdbc:postgresql://postgres:5432/restaurante_db
# NOTA LOCAL: Se rodar direto na máquina com Maven (fora do Docker), use 'localhost':
#   jdbc:postgresql://localhost:5432/restaurante_db
# ------------------------------------------------------------------------------
DATASOURCE_URL=jdbc:postgresql://postgres:5432/restaurante_db
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=your_secure_db_password_here
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# ------------------------------------------------------------------------------
# 3. Porta da Aplicação
# ------------------------------------------------------------------------------
SERVER_PORT=8080

# ------------------------------------------------------------------------------
# 4. Segurança e Autenticação JWT (Chave secreta forte em produção)
# ------------------------------------------------------------------------------
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_ISSUER=restaurant-api

# ------------------------------------------------------------------------------
# 5. CORS / Origens Permitidas no Frontend (separadas por vírgula)
# ------------------------------------------------------------------------------
SECURITY_ORIGINS=http://localhost:3000,http://localhost:5173,http://apilabella.duckdns.org
FRONT_DEFAULT_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 6. Administrador Inicial (Criado automaticamente no primeiro boot se não existir)
# ------------------------------------------------------------------------------
ADMIN_DEFAULT_LOGIN=admin@seurestaurante.com
ADMIN_DEFAULT_PASSWORD=SuaSenhaForteAqui@2026
ADMIN_DEFAULT_NAME=Administrador Geral
ADMIN_DEFAULT_PHONE=5538999999999
