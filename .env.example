# ==============================================================================
# Configurações de Exemplo de Ambiente - Restaurante API (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais de produção/desenvolvimento
# ==============================================================================

# Banco de Dados PostgreSQL
DATASOURCE_URL=jdbc:postgresql://localhost:5432/restaurant
DATASOURCE_USERNAME=postgres
DATASOURCE_PASSWORD=your_secure_db_password_here
DB_MAX_POOL_SIZE=20
DB_MIN_IDLE=5

# Segurança e Autenticação JWT (Chave secreta forte em produção)
JWT_SECRET=your_jwt_secret_key_minimum_256_bits_here
JWT_ISSUER=restaurant-api

# CORS / Origens Permitidas no Frontend (separadas por vírgula)
SECURITY_ORIGINS=http://localhost:3000,http://localhost:5173
FRONT_DEFAULT_URL=http://localhost:3000

# Porta da Aplicação
SERVER_PORT=8080
